// components/PropertyCard.js
import React, { useState ,useEffect,useContext} from 'react';
import {
  Box,
  Card,
  CardMedia,
  CardContent,
  Typography,
  Tooltip,
  IconButton,
  Divider,
  Grid,
  Button,
  CircularProgress,
  Paper
} from '@mui/material';
import { useNavigate } from 'react-router-dom';
import axios from 'axios';
import { BASE_URL } from './../../Api/ApiUrls';
import { AuthContext } from './../../AuthContext/AuthContext';
import { Favorite, FavoriteBorder, Share, Chat, Close, ThumbUpAlt, ThumbUpAltOutlined, Call, LocationOn, ChevronLeft, ChevronRight } from '@mui/icons-material';

const ReUsableCard = ({ property, onCardClick, isSaved, toggleSave, likedCards, toggleLike, onClose, isSubscribed }) => {
  const [currentImageIndex, setCurrentImageIndex] = useState(0);
  const [loading, setLoading] = useState(false);
  const [showSubscribeModal, setShowSubscribeModal] = useState(false);
  const [featureRequested, setFeatureRequested] = useState('');
   const [showLimitModal, setShowLimitModal] = useState(false);
  const [userActivities, setUserActivities] = useState([]);
  const navigate = useNavigate();
  const { userId, logout } = useContext(AuthContext);
  const [userPlan, setUserPlan] = useState(null);

  const images = property.images && property.images.length > 0
    ? property.images
    : ['/default-property-image.jpg'];

  const handleNextImage = (e) => {
    e.stopPropagation();
    setCurrentImageIndex((prevIndex) => (prevIndex + 1) % images.length);
  };

  const handlePrevImage = (e) => {
    e.stopPropagation();
    setCurrentImageIndex((prevIndex) => (prevIndex - 1 + images.length) % images.length);
  };

 

// Fetch user plan when component mounts or userId changes
useEffect(() => {
  const fetchUserPlan = async () => {
    if (!userId) return;
    
    try {
      const response = await axios.get(`${BASE_URL}/Get-user-plan/${userId}/`);
      setUserPlan(response.data);
    } catch (error) {
      console.error('Error fetching user plan:', error);
      setUserPlan(null);
    }
  };

  fetchUserPlan();
}, [userId]);

// Fetch and filter user activities
useEffect(() => {
  const fetchUserActivities = async () => {
    if (!userId) {
      console.log('No userId - skipping activity fetch');
      return;
    }
    
    try {
      console.log(`Fetching activities for user ${userId}`);
      const response = await fetch(`${BASE_URL}/activities/`);
      
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      
      const allActivities = await response.json();
      console.log('All activities from API:', allActivities);
      
      // Enhanced filtering with type checking
      const filteredActivities = allActivities.filter(activity => {
        // Check if activity exists and has user_id property
        if (!activity || activity.user_id === undefined) {
          console.warn('Invalid activity object:', activity);
          return false;
        }
        
        // Compare user_id (convert both to string for safety)
        return String(activity.user_id) === String(userId);
      });
      
      console.log('Filtered user activities:', filteredActivities);
      setUserActivities(filteredActivities);
      
    } catch (error) {
      console.error('Error fetching activities:', error);
      setUserActivities([]);
    }
  };

  fetchUserActivities();
}, [userId]);

const checkPropertyLimit = (currentPropertyId) => {
  if (!isSubscribed) {
    console.log('Non-subscriber - access denied');
    setFeatureRequested("Property Access");
    setShowSubscribeModal(true);
    return false;
  }

  // If unlimited access is granted
  if (userPlan?.no_of_properties_unlimited) {
    console.log('User has unlimited property access');
    return true;
  }

  const uniqueProperties = new Set(userActivities.map(a => a.property_id));
  const isExistingProperty = uniqueProperties.has(currentPropertyId);
  
  console.log(`User has accessed ${uniqueProperties.size} unique properties`);
  console.log(`Is current property already accessed? ${isExistingProperty}`);

  // Get the dynamic limit from user plan, default to 10 if not available
  const propertyLimit = userPlan?.no_of_properties || 10;
  
  if (uniqueProperties.size >= propertyLimit && !isExistingProperty) {
    console.log(`Property limit (${propertyLimit}) exceeded - showing limit modal`);
    setShowLimitModal(true);
    return false;
  }
  
  return true;
};

  // Enhanced logActivity function with better error handling
const logActivity = async (activityType) => {
  try {
    // First check property limit
    if (!checkPropertyLimit(property.id)) {
      return false;
    }

    const activityData = {
      user_id: userId,
      property_id: property.id,
      activity_type: activityType,
      property_by: property.owner    
    };

    console.log('Posting activity:', activityData);

    const response = await fetch(`${BASE_URL}/activities/`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(activityData)
    });

    if (!response.ok) {
      const errorData = await response.json();
      console.error('Activity post failed:', errorData);
      throw new Error(errorData.message || 'Failed to log activity');
    }
    
    const newActivity = await response.json();
    console.log('Activity logged successfully:', newActivity);
    setUserActivities(prev => [...prev, newActivity]);
    return true;
  } catch (err) {
    console.error("Error logging activity:", err);
    return false;
  }
};

// Updated handleAction to properly sequence checks
const handleAction = async (e, actionName, actionCallback, activityType) => {
  e.stopPropagation();
  
  if (!isSubscribed) {
    setFeatureRequested(actionName);
    setShowSubscribeModal(true);
    return;
  }

  // Check property limit before executing action
  if (activityType && !checkPropertyLimit(property.id)) {
    return;
  }

  try {
    // Execute the action
    await actionCallback();
    
    // Log activity if specified
    if (activityType) {
      await logActivity(activityType);
    }
  } catch (error) {
    console.error(`Error in ${actionName} action:`, error);
    alert(`Failed to complete ${actionName} action`);
  }
};

// Updated handlers with proper activity logging
const handleCallClick = (e) => {
  handleAction(e, "Call", async () => {
    await navigator.clipboard.writeText(property.mobile_no);
    alert(`Copied: ${property.mobile_no}`);
  }, "Call");
};

const handleMessageClick = (e) => {
  handleAction(e, "Call", async () => {
    navigate('/chat', { state: { property: property.id } });
  }, "Call");
};

const handleLikeClick = (e) => {
  handleAction(e, "Liked", () => {
    toggleLike(property.id);
  }, "Liked");
};

const handleLocationClick = (e) => {
  handleAction(e, "Location", async () => {
    setLoading(true);
    const openInMaps = (url) => {
      setLoading(false);
      window.open(url, '_blank', 'noopener,noreferrer');
    };

    const fallbackUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(property.location)}`;
    
    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(
        (position) => {
          const userLat = position.coords.latitude;
          const userLng = position.coords.longitude;
          const mapsUrl = property.lat && property.lng
            ? `https://www.google.com/maps/dir/?api=1&origin=${userLat},${userLng}&destination=${property.lat},${property.lng}&travelmode=driving`
            : fallbackUrl;
          openInMaps(mapsUrl);
        },
        (error) => {
          console.error("Error getting user location:", error);
          openInMaps(fallbackUrl);
        },
        { timeout: 10000 }
      );
    } else {
      openInMaps(fallbackUrl);
    }
  }, "Location");
};

const handleWishlistClick = async (e) => {
  e.stopPropagation();
  
  try {
    if (!isSubscribed) {
      setFeatureRequested("Liked");
      setShowSubscribeModal(true);
      return;
    }

    // Check limit before proceeding
    if (!checkPropertyLimit(property.id)) {
      return;
    }

    // First toggle the save state locally
    toggleSave(property);
    
    // Then log the activity to the API
    await logActivity("Liked");
  } catch (err) {
    console.error("Error:", err);
    // If API call fails, revert the local toggle
    toggleSave(property);
    alert(`Failed to update wishlist: ${err.message}`);
  }
};
  // Share click handler (no property limit check needed)
  const handleShareClick = (e) => {
    e.stopPropagation();
    const phone = `91${property.mobile_no}`;
    window.location.href = `https://wa.me/${phone}`;
  };




  const handleSubscriptionRequired = (e, featureName) => {
    e.stopPropagation();
    if (!isSubscribed) {
      setFeatureRequested(featureName);
      setShowSubscribeModal(true);
      return false;
    }
    return true;
  };


   const handleLimitExceeded = () => {
    setShowLimitModal(true);
    return false;
  };



  return (
    <>
    <Card
      sx={{
        mb: 4,
        mx: 2,
        borderRadius: 4,
        boxShadow: 3,
        transition: 'transform 0.2s ease-in-out',
        '&:hover': { transform: 'scale(1.015)', boxShadow: 6 }
      }}
      onClick={(e) => {
        const isButtonClick = e.target.closest('button') || e.target.closest('svg');
        if (!isButtonClick && onCardClick) {
          onCardClick();
        }
      }}
    >
      <Box position="relative">
        {onClose && (
          <Tooltip title="Close">
            <IconButton
              sx={{
                bgcolor: 'white',
                boxShadow: 1,
                position: 'absolute',
                top: 8,
                left: 8,
                zIndex: 2
              }}
              onClick={(e) => {
                e.stopPropagation();
                onClose();
              }}
            >
              <Close />
            </IconButton>
          </Tooltip>
        )}

        {/* Carousel Container */}
        <Box sx={{ position: 'relative', width: '100%', height: '160px' }}>
          <CardMedia
            component="img"
            image={images[currentImageIndex]}
            alt="Property"
            sx={{
              width: '100%',
              height: '160px',
              objectFit: 'cover',
              borderTopLeftRadius: 16,
              borderTopRightRadius: 16
            }}
          />

          {/* Carousel Navigation Arrows */}
          {property.images.length > 1 && (
            <>
              <IconButton
                sx={{
                  position: 'absolute',
                  top: '50%',
                  left: 8,
                  opacity: 0,
                  transform: 'translateY(-50%)',
                  backgroundColor: 'rgba(255,255,255,0.3)',
                  backdropFilter: 'blur(2px)',
                  '&:hover': {
                    opacity: 1,
                    backgroundColor: 'rgba(255,255,255,0.5)'
                  }
                }}
                onClick={handlePrevImage}
              >
                <ChevronLeft fontSize="small" />
              </IconButton>
              <IconButton
                sx={{
                  position: 'absolute',
                  top: '50%',
                  right: 8,
                  opacity: 0,
                  transform: 'translateY(-50%)',
                  backgroundColor: 'rgba(255,255,255,0.3)',
                  backdropFilter: 'blur(2px)',
                  '&:hover': {
                    opacity: 1,
                    backgroundColor: 'rgba(255,255,255,0.5)'
                  }
                }}
                onClick={handleNextImage}
              >
                <ChevronRight fontSize="small" />
              </IconButton>
            </>
          )}

          {/* Carousel Indicators */}
          {property.images.length > 1 && (
            <Box
              sx={{
                position: 'absolute',
                bottom: 10,
                left: '50%',
                transform: 'translateX(-50%)',
                display: 'flex',
                gap: 1
              }}
            >
              {property.images.map((_, index) => (
                <Box
                  key={index}
                  onClick={(e) => {
                    e.stopPropagation();
                    setCurrentImageIndex(index);
                  }}
                  sx={{
                    width: 8,
                    height: 8,
                    borderRadius: '50%',
                    backgroundColor: currentImageIndex == index ? '#1976d2' : '#ccc',
                    cursor: 'pointer',
                    transition: 'background-color 0.3s'
                  }}
                />
              ))}
            </Box>
          )}
        </Box>

        <Box sx={{ position: 'absolute', top: 8, right: 8, display: 'flex', gap: 1 }}>
         
  <Tooltip title="Add to Wishlist">
          <IconButton
            sx={{ bgcolor: 'white', boxShadow: 1 }}
            onClick={handleWishlistClick}
          >
            {isSaved(property) ? <Favorite color="error" /> : <FavoriteBorder />}
          </IconButton>
        </Tooltip>

           <Tooltip title="Share">
          <IconButton
            sx={{ bgcolor: 'white', boxShadow: 1 }}
            onClick={handleShareClick}
          >
            <Share />
          </IconButton>
        </Tooltip>


        </Box>

        <Box sx={{ position: 'absolute', bottom: 8, right: 8 }}>
          <Tooltip title="Like">
            <IconButton
              sx={{
                bgcolor: 'white',
                boxShadow: 1,
                color: likedCards?.[property.id] ? 'blue' : 'default'
              }}
            
              onClick={handleLikeClick}
            >
              {likedCards?.[property.id] ? <ThumbUpAlt /> : <ThumbUpAltOutlined />}
            </IconButton>
          </Tooltip>
        </Box>
      </Box>

      <CardContent sx={{ px: 2, py: 0.5, pb: '7px !important' }}>
        {/* Title and Price - Strictly aligned */}
        <Box sx={{
          display: 'flex',
          justifyContent: 'space-between',
          alignItems: 'flex-start',
          gap: 1,
          mb: 0.5
        }}>
          <Typography
            variant="subtitle1"
            fontWeight="bold"
            sx={{
              fontSize: '1rem',
              flex: 1,
              whiteSpace: 'nowrap',
              overflow: 'hidden',
              textOverflow: 'ellipsis'
            }}
          >
            {property.title}-{property.property_name}
          </Typography>
          <Typography
            variant="subtitle1"
            fontWeight="bold"
            color="primary"
            sx={{
              fontSize: '0.9rem',
              whiteSpace: 'nowrap',
              ml: 1
            }}
          >
            ₹{Number(String(property.price).replace(/[^0-9]/g, '')).toLocaleString('en-IN')}
          </Typography>
        </Box>

        {/* Location and Date - Strictly aligned */}
        <Box sx={{
          display: 'flex',
          justifyContent: 'space-between',
          alignItems: 'center',
          gap: 1,
          mb: 0.5
        }}>
          <Typography
            variant="body2"
            color="text.secondary"
            sx={{
              flex: 1,
              whiteSpace: 'nowrap',
              overflow: 'hidden',
              textOverflow: 'ellipsis'
            }}
          >
            {property.location}
          </Typography>
          <Typography
            variant="caption"
            color="text.secondary"
            sx={{
              whiteSpace: 'nowrap',
              ml: 1
            }}
          >
            {new Date(property.date).toLocaleDateString('en-IN', {
              day: '2-digit',
              month: '2-digit',
              year: 'numeric'
            })}
          </Typography>
        </Box>

        {/* Location verified + Call Button */}
        <Box sx={{
          display: 'flex',
          alignItems: 'center',
          mt: 0.5,
          mb: 1
        }}>
         <Tooltip title="View directions in Google Maps">
          <Box display="flex" alignItems="center">
            <IconButton
              size="small"
              onClick={handleLocationClick}
              sx={{ p: 0, color: 'primary.main' }}
              disabled={loading}
            >
              {loading ? (
                <CircularProgress size={16} color="inherit" />
              ) : (
                <LocationOn fontSize="small" />
              )}
            </IconButton>
            <Typography variant="body2" color="text.primary" sx={{ ml: 0.5 }}>
              Location
            </Typography>
          </Box>
        </Tooltip>

          <Tooltip title="Send Message">
          <IconButton
            size="small"
            onClick={handleMessageClick}
            sx={{ p: 0, color: 'primary.main', ml: 1 }}
          >
            <Chat fontSize="small" />
          </IconButton>
        </Tooltip>
          <Box sx={{ flexGrow: 1 }} />

        <Button
          size="small"
          variant="outlined"
          color="success"
          startIcon={<Call fontSize="small" />}
          sx={{
            textTransform: 'none',
            fontSize: '0.75rem',
            py: 0.2,
            px: 1.5,
            minWidth: 'fit-content'
          }}
          onClick={handleCallClick}
        >
          Call
        </Button>


        </Box>

        {/* Property Info Columns - Compact and Consistent */}
        <Box sx={{
          display: 'flex',
          border: '1px solid #e0e0e0',
          borderRadius: 1,
          overflow: 'hidden',
          '& > div:not(:last-child)': {
            borderRight: '1px solid #e0e0e0'
          }
        }}>
          {[
            {
              label: 'Facing',
              value: property.facing || 'N/A',
              width: '30%'
            },
            {
              label: 'Area Sqft',
              value: property.length && property.width
                ? `${property.length * property.width} sqft`
                : 'N/A',
              width: '40%'
            },
            {
              label: 'Listed By',
              value: property.listedBy || 'N/A',
              width: '30%'
            }
          ].map((item, index) => (
            <Box
              key={index}
              sx={{
                width: item.width,
                px: 0.5,
                py: 0.5,
                textAlign: 'center'
              }}
            >
              <Typography
                variant="caption"
                color="text.secondary"
                sx={{
                  fontSize: '0.65rem',
                  lineHeight: 1.2,
                  display: 'block'
                }}
              >
                {item.label}
              </Typography>
              <Typography
                variant="body2"
                fontWeight="bold"
                sx={{
                  fontSize: '0.75rem',
                  lineHeight: 1.2,
                  whiteSpace: 'nowrap',
                  overflow: 'hidden',
                  textOverflow: 'ellipsis'
                }}
              >
                {item.value}
              </Typography>
            </Box>
          ))}
        </Box>
      </CardContent>
    </Card>
       {/* Subscription Modal - This was missing the proper placement */}
       
      {showSubscribeModal && (
        <Box sx={{
          position: 'fixed',
          top: 0,
          left: 0,
          right: 0,
          bottom: 0,
          backgroundColor: 'rgba(0,0,0,0.5)',
          zIndex: 9999,
          display: 'flex',
          justifyContent: 'center',
          alignItems: 'center'
        }}>
          <Paper sx={{
            padding: 3,
            maxWidth: 300,
            textAlign: 'center'
          }}>
            <Typography variant="h6" gutterBottom>
              Subscription Required
            </Typography>
            <Typography variant="body1" sx={{ mb: 2 }}>
              Please subscribe to use the {featureRequested} feature.
            </Typography>
            <Button 
              variant="contained" 
              color="primary"
              onClick={() => setShowSubscribeModal(false)}
            >
              OK
            </Button>
          </Paper>
        </Box>
      )}
 
{/* Limit Exceeded Modal */}
{showLimitModal && (
  <Box sx={{
    position: 'fixed',
    top: 0,
    left: 0,
    right: 0,
    bottom: 0,
    backgroundColor: 'rgba(0,0,0,0.5)',
    zIndex: 9999,
    display: 'flex',
    justifyContent: 'center',
    alignItems: 'center'
  }}>
    <Paper sx={{ padding: 3, maxWidth: 300, textAlign: 'center' }}>
      <Typography variant="h6" gutterBottom>
        Limit Exceeded
      </Typography>
      <Typography variant="body1" sx={{ mb: 2 }}>
        {userPlan?.no_of_properties_unlimited 
          ? "You have unlimited access to properties."
          : `You've reached your limit of ${userPlan?.no_of_properties || 10} properties. 
             Please upgrade your subscription plan for more.`
        }
      </Typography>
      <Button 
        variant="contained" 
        color="primary"
        onClick={() => setShowLimitModal(false)}
      >
        OK
      </Button>
    </Paper>
  </Box>
)}

 </>
  );
};

export default ReUsableCard;