import React, { useRef, useState, useEffect } from 'react';
import { Search, Tune, Close, Room } from '@mui/icons-material';
import ArrowBackIosNewIcon from '@mui/icons-material/ArrowBackIosNew';
import {
  Box,
  IconButton,
  InputBase,
  Paper,
  List,
  ListItem,
  ListItemIcon,
  ListItemText,
  Menu,
  MenuItem,
  Typography,
  Divider
} from '@mui/material';
import { useNavigate } from 'react-router-dom';

const priceRanges = [
  { label: '1K - 10K', min: 1000, max: 10000 },
  { label: '10K - 50K', min: 10000, max: 50000 },
  { label: '50K - 1L', min: 50000, max: 100000 },
  { label: '1L - 20L', min: 100000, max: 2000000 },
  { label: '20L - 40L', min: 2000000, max: 4000000 },
  { label: '40L - 60L', min: 4000000, max: 6000000 },
  { label: '60L & above', min: 6000000, max: Infinity }
];

const CustomSearchBar = ({ onPlaceSelected, onClear, onPriceFilterChange }) => {
  const navigate = useNavigate();
  const inputRef = useRef(null);
  const autocompleteRef = useRef(null);
  const [searchValue, setSearchValue] = useState('');
  const [showSuggestions, setShowSuggestions] = useState(false);
  const [recentSearches, setRecentSearches] = useState([]);
  const [anchorEl, setAnchorEl] = useState(null);
  const [selectedPriceRange, setSelectedPriceRange] = useState(null);
  const [apiLoaded, setApiLoaded] = useState(false);

  // Load saved search and recent searches on mount
  useEffect(() => {
    const savedSearch = localStorage.getItem('savedSearchValue');
    if (savedSearch) setSearchValue(savedSearch);

    const savedSearches = localStorage.getItem('recentLocationSearches');
    if (savedSearches) setRecentSearches(JSON.parse(savedSearches));

    // Check if Google Maps API is already loaded
    if (window.google && window.google.maps && window.google.maps.places) {
      setApiLoaded(true);
      initAutocomplete();
    } else {
      loadGoogleMapsAPI();
    }
  }, []);

  const loadGoogleMapsAPI = () => {
    if (document.querySelector(`script[src*="maps.googleapis.com/maps/api/js"]`)) {
      // Script is already in the DOM, just waiting for it to load
      return;
    }

    const script = document.createElement('script');
    script.src = `https://maps.googleapis.com/maps/api/js?key=AIzaSyAZAU88Lr8CEkiFP_vXpkbnu1-g-PRigXU&libraries=places`;
    script.async = true;
    script.defer = true;
    script.onload = () => {
      setApiLoaded(true);
      initAutocomplete();
    };
    script.onerror = () => {
      console.error('Google Maps API failed to load');
    };
    document.head.appendChild(script);
  };

  const initAutocomplete = () => {
    if (!inputRef.current) return;

    try {
      autocompleteRef.current = new window.google.maps.places.Autocomplete(
        inputRef.current,
        {
          types: ['geocode'],
          componentRestrictions: { country: 'in' },
        }
      );

      autocompleteRef.current.addListener('place_changed', () => {
        const place = autocompleteRef.current.getPlace();
        handlePlaceSelected(place);
      });
    } catch (error) {
      console.error('Error initializing Autocomplete:', error);
    }
  };

  // Save recent searches to localStorage
  useEffect(() => {
    localStorage.setItem('recentLocationSearches', JSON.stringify(recentSearches));
  }, [recentSearches]);

  // Save searchValue to localStorage to persist across navigation
  useEffect(() => {
    if (searchValue) {
      localStorage.setItem('savedSearchValue', searchValue);
    }
  }, [searchValue]);

const handlePlaceSelected = (place) => {
  if (place.geometry) {
    const locationData = {
      lat: place.geometry.location.lat(),
      lng: place.geometry.location.lng(),
      address: place.formatted_address,
      name: place.name || place.formatted_address,
      radius: 10000 // 10km in meters
    };

    // Add to recent searches (deduplicated and limited to 5)
    setRecentSearches((prev) => [
      locationData,
      ...prev.filter((item) => item.address !== locationData.address).slice(0, 4),
    ]);

    onPlaceSelected(locationData); // This should trigger the parent component
    setSearchValue(locationData.name);
    setShowSuggestions(false);
    
    // Force a re-render by clearing and resetting the search value
    setSearchValue('');
    setTimeout(() => setSearchValue(locationData.name), 0);
  }
};
  const handleRecentSearchClick = (search) => {
    onPlaceSelected(search);
    setSearchValue(search.name);
    setShowSuggestions(false);
  };

  const clearSearch = () => {
    setSearchValue('');
    inputRef.current?.focus();
    if (onClear) onClear();
  };

  const clearRecentSearches = () => {
    setRecentSearches([]);
  };

  const handleTuneClick = (event) => {
    setAnchorEl(event.currentTarget);
  };

  const handleMenuClose = () => {
    setAnchorEl(null);
  };

  const handlePriceRangeSelect = (range) => {
    setSelectedPriceRange(range);
    if (onPriceFilterChange) {
      onPriceFilterChange(range);
    }
    handleMenuClose();
  };

  const clearPriceFilter = () => {
    setSelectedPriceRange(null);
    if (onPriceFilterChange) {
      onPriceFilterChange(null);
    }
    handleMenuClose();
  };

  return (
    <Box sx={{ position: 'relative' }}>
      <Paper
        component="form"
        elevation={0}
        sx={{
          display: 'flex',
          alignItems: 'center',
          borderRadius: '30px',
          px: 1,
          backgroundColor: '#f2f5f7',
          border: '1px solid black',
          mx: 0.5,
          my: 0.5,
        }}
        onSubmit={(e) => e.preventDefault()}
      >
        <IconButton onClick={() => navigate(-1)} sx={{ color: 'black' }}>
          <ArrowBackIosNewIcon />
        </IconButton>

        <InputBase
          inputRef={inputRef}
          sx={{ ml: 1, flex: 1 }}
          placeholder="Search location..."
          value={searchValue}
          onChange={(e) => setSearchValue(e.target.value)}
          onFocus={() => setShowSuggestions(true)}
        />

        {searchValue && (
          <IconButton onClick={clearSearch} sx={{ color: 'black' }}>
            <Close fontSize="small" />
          </IconButton>
        )}

        <IconButton type="submit" sx={{ color: 'black' }}>
          <Search />
        </IconButton>

        <IconButton 
          sx={{ color: 'black' }}
          onClick={handleTuneClick}
          aria-label="filter"
          aria-controls="filter-menu"
          aria-haspopup="true"
        >
          <Tune />
        </IconButton>
      </Paper>

      {/* Suggestions dropdown */}
      {showSuggestions && recentSearches.length > 0 && (
        <Paper sx={{ 
          position: 'absolute', 
          top: '100%', 
          left: 0, 
          right: 0, 
          zIndex: 1,
          mt: 1,
          maxHeight: 300,
          overflow: 'auto'
        }}>
          <List>
            <ListItem 
              button 
              onClick={clearRecentSearches}
              sx={{ justifyContent: 'flex-end' }}
            >
              <Typography variant="caption" color="text.secondary">
                Clear History
              </Typography>
            </ListItem>
            {recentSearches.map((search, index) => (
              <ListItem 
                button 
                key={index} 
                onClick={() => handleRecentSearchClick(search)}
              >
                <ListItemIcon>
                  <Room color="primary" />
                </ListItemIcon>
                <ListItemText 
                  primary={search.name} 
                  secondary={search.address} 
                />
              </ListItem>
            ))}
          </List>
        </Paper>
      )}

      {/* Filter Menu */}
      <Menu
        id="filter-menu"
        anchorEl={anchorEl}
        keepMounted
        open={Boolean(anchorEl)}
        onClose={handleMenuClose}
        PaperProps={{
          style: {
            width: '250px',
            padding: '8px 0',
          },
        }}
      >
        <Typography variant="subtitle2" sx={{ px: 2, py: 1, fontWeight: 'bold' }}>
          Price Range
        </Typography>
        <Divider />
        {priceRanges.map((range) => (
          <MenuItem
            key={range.label}
            onClick={() => handlePriceRangeSelect(range)}
            selected={selectedPriceRange?.label === range.label}
          >
            {range.label}
          </MenuItem>
        ))}
        {selectedPriceRange && (
          <>
            <Divider />
            <MenuItem onClick={clearPriceFilter} sx={{ color: 'error.main' }}>
              Clear Filter
            </MenuItem>
          </>
        )}
      </Menu>
    </Box>
  );
};

export default CustomSearchBar;