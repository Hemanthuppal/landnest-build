import React, { useState, useEffect } from 'react';
import {
  Box,
  Typography,
  Card,
  Table,
  TableBody,
  TableCell,
  TableRow,
  Divider,
  Button,
  Container,
  Alert,
  Chip,
  CircularProgress,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions
} from '@mui/material';

const ActiveSubscription = ({ subscriptions, userData, navigate }) => {
  const [eligibleReward, setEligibleReward] = useState(null);
  const [loadingReward, setLoadingReward] = useState(true);
  const [rewardError, setRewardError] = useState(null);
  const [referralCount, setReferralCount] = useState(0);
  const [rewardModalOpen, setRewardModalOpen] = useState(false);
  const [claimingReward, setClaimingReward] = useState(false);
  const [claimError, setClaimError] = useState(null);
   const [addOnPlans, setAddOnPlans] = useState([]);
  const [loadingAddOns, setLoadingAddOns] = useState(false);
  const [addOnError, setAddOnError] = useState(null);

   useEffect(() => {
    const checkReferralReward = async () => {
      try {
        setLoadingReward(true);
        
        const userResponse = await fetch(`https://landnest.net:81/users/${userData.user_id}/`);
        if (!userResponse.ok) throw new Error('Failed to fetch user data');
        const user = await userResponse.json();
        
        const count = user.no_of_referred_for_rew || 0;
        setReferralCount(count);
        
        const rewardsResponse = await fetch('https://landnest.net:81/rewards/');
        if (!rewardsResponse.ok) throw new Error('Failed to fetch rewards');
        const rewards = await rewardsResponse.json();
        
        const matchedReward = rewards.find(
          reward => Number(reward.no_of_users) === Number(count)
        );
        
        if (matchedReward) {
          setEligibleReward(matchedReward);
        }
        
      } catch (err) {
        setRewardError(err.message);
        console.error("Error checking referral reward:", err);
      } finally {
        setLoadingReward(false);
      }
    };

    const fetchAddOnPlans = async () => {
      try {
        setLoadingAddOns(true);
        const response = await fetch(`https://landnest.net:81/Get-addon/${userData.user_id}/`);
        if (!response.ok) throw new Error('Failed to fetch add-on plans');
        const data = await response.json();
        setAddOnPlans(data);
      } catch (err) {
        setAddOnError(err.message);
        console.error("Error fetching add-on plans:", err);
      } finally {
        setLoadingAddOns(false);
      }
    };

    if (userData?.user_id) {
      checkReferralReward();
      fetchAddOnPlans();
    }
  }, [userData]);

const handleClaimReward = async (rewardType) => {
  try {
    console.log('[Claim Reward] Starting reward claim process...');
    console.log('[Claim Reward] Reward type selected:', rewardType);
    console.log('[Claim Reward] Current user ID:', userData.user_id);
    
    setClaimingReward(true);
    setClaimError(null);
    
    // Prepare payload based on reward type
    let payload;
    if (rewardType === 'Credits') {
      payload = {
        user_id: userData.user_id,
        reward_type: 'Credits',
        credit_points: eligibleReward?.credit_points || 0
      };
    } else if (rewardType === 'extend_plan') {
      payload = {
        user_id: userData.user_id,
        reward_type: 'extend_plan'
      };
    } else {
      throw new Error('Invalid reward type selected');
    }
    
    console.log('[Claim Reward] Prepared payload:', payload);

    const response = await fetch('https://landnest.net:81/user-reward/', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        // Add authorization header if needed
        // 'Authorization': `Bearer ${yourAuthToken}`
      },
      body: JSON.stringify(payload)
    });

    console.log('[Claim Reward] Response status:', response.status);
    
    if (!response.ok) {
      // Try to get error details from response
      let errorDetails = '';
      try {
        const errorResponse = await response.json();
        errorDetails = errorResponse.message || JSON.stringify(errorResponse);
        console.error('[Claim Reward] Error details:', errorDetails);
      } catch (e) {
        errorDetails = 'Could not parse error response';
      }
      
      throw new Error(`Server responded with status ${response.status}: ${errorDetails}`);
    }

    const result = await response.json();
    console.log('[Claim Reward] Success! Server response:', result);
    
    // Close the modal and reset state
    setRewardModalOpen(false);
    setEligibleReward(null);
    
    // Show success message
    const successMessage = rewardType === 'Credits' 
      ? `Success! ${eligibleReward?.credit_points || 0} credit points added to your account`
      : 'Your plan has been extended successfully!';
    
    alert(successMessage);

  } catch (err) {
    console.error('[Claim Reward] Error:', err.message);
    console.error('[Claim Reward] Full error:', err);
    
    // User-friendly error messages
    let userFriendlyError = 'Failed to claim reward. Please try again.';
    if (err.message.includes('500')) {
      userFriendlyError = 'Server error. Please try again later or contact support.';
    } else if (err.message.includes('401')) {
      userFriendlyError = 'Session expired. Please log in again.';
    } else if (err.message.includes('400')) {
      userFriendlyError = 'Invalid request. Please check your details.';
    }
    
    setClaimError(userFriendlyError);
  } finally {
    setClaimingReward(false);
  }
};

  const renderAddOnFeatures = (addOn) => {
    const userType = addOn.user_type?.toLowerCase();
    
    return (
      <Box component="ul" sx={{ pl: 2, mb: 2 }}>
        {['buyer', 'tenant'].includes(userType) ? (
          <>
            <li>
              Additional owner details : 
              {addOn.no_of_properties_unlimited 
                ? ' Unlimited' 
                : ` ${addOn.no_of_properties || '0'}`}
            </li>
          </>
        ) : (
          <>
            <li>
              Additional property listings: 
              {addOn.no_of_properties_unlimited 
                ? ' Unlimited' 
                : ` ${addOn.no_of_properties || '0'}`}
            </li>
            {addOn.matching_enquiry > 0 && (
              <li>
                Additional buyer inquiries: {addOn.matching_enquiry}
              </li>
            )}
            {addOn.no_of_liked_data > 0 && (
              <li>
                Additional wishlist access: {addOn.no_of_liked_data}
              </li>
            )}
          </>
        )}
      </Box>
    );
  };

  return (
    <Container
      sx={{
        py: 2,
        flex: 1,
        display: 'flex',
        flexDirection: 'column',
        gap: 2,
        maxWidth: 'sm'
      }}
    >
      <Typography variant="h5" gutterBottom sx={{ textAlign: 'center', mt: 2 }}>
        Your Active Subscription
      </Typography>
      
      {loadingReward ? (
        <Box sx={{ display: 'flex', justifyContent: 'center' }}>
          <CircularProgress size={24} />
        </Box>
      ) : eligibleReward ? (
        <Alert severity="success" sx={{ mb: 2 }}>
          <Typography variant="body1" fontWeight="bold">
            Congratulations! You've referred {eligibleReward.no_of_users} users and earned a reward!
          </Typography>
          <Box sx={{ display: 'flex', alignItems: 'center', mt: 1 }}>
            <Button 
              size="small" 
              variant="contained" 
              color="success"
              onClick={() => setRewardModalOpen(true)}
            >
              Claim Reward
            </Button>
          </Box>
        </Alert>
      ) : (
        <Alert severity="info" sx={{ mb: 2 }}>
          You've referred {referralCount} users. Keep referring to earn rewards!
        </Alert>
      )}
      
      {rewardError && (
        <Alert severity="error" sx={{ mb: 2 }}>
          Error checking referral rewards: {rewardError}
        </Alert>
      )}

      {/* Reward Selection Modal */}
      <Dialog open={rewardModalOpen} onClose={() => setRewardModalOpen(false)}>
        <DialogTitle>Select Your Reward</DialogTitle>
        <DialogContent>
          <Typography variant="body1" sx={{ mb: 2 }}>
            Choose the type of reward you'd like to claim:
          </Typography>
          
          {claimError && (
            <Alert severity="error" sx={{ mb: 2 }}>
              {claimError}
            </Alert>
          )}
          
          <Box sx={{ display: 'flex', gap: 2, justifyContent: 'center', mt: 2 }}>
           <Button 
  variant="contained" 
  color="primary"
  onClick={() => handleClaimReward('Credits')}
  disabled={claimingReward}
>
  {eligibleReward?.credit_points || 0} Credit Points
</Button>
<Button 
  variant="contained" 
  color="secondary"
  onClick={() => handleClaimReward('extend_plan')}
  disabled={claimingReward}
>
  Extend Plan
</Button>
          </Box>
        </DialogContent>
        <DialogActions>
          <Button 
            onClick={() => setRewardModalOpen(false)}
            disabled={claimingReward}
          >
            Cancel
          </Button>
        </DialogActions>
      </Dialog>

    {/* Display all subscriptions */}
 {subscriptions.map((subscription, index) => {
        const userType = subscription.user_type?.toLowerCase();
        // Filter add-ons that match this subscription's user_type
        const matchingAddOns = addOnPlans.filter(addOn => 
          addOn.user_type.toLowerCase() === userType
        );
        
        return (
          <React.Fragment key={index}>
            <Card 
              sx={{
                borderRadius: '12px',
                boxShadow: '0 4px 20px rgba(0,0,0,0.1)',
                background: subscription.status ? 'rgba(255, 255, 255, 0.8)' : 'rgba(255, 255, 255, 0.6)',
                p: 3,
                mb: 2,
              }}
            >
              <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                <Typography variant="h6" color="primary">
                  {subscription.plan_name} {subscription.user_type} Plan
                </Typography>
                <Chip 
                  label={subscription.status ? 'Active' : 'Inactive'} 
                  color={subscription.status ? 'success' : 'default'} 
                  size="small"
                />
              </Box>
              
              <Table size="small" sx={{ mt: 1 }}>
                <TableBody>
                  <TableRow>
                    <TableCell sx={{ fontWeight: 'bold' }}>Price:</TableCell>
                    <TableCell>₹{subscription.charges}</TableCell>
                  </TableRow>
                  {(subscription.plan_name !== 'Lifetime' && subscription.plan_name !== 'Free') && (
                    <TableRow>
                      <TableCell sx={{ fontWeight: 'bold' }}>Expiration Date:</TableCell>
                      <TableCell>
                        {new Date(subscription.expired_date).toLocaleDateString('en-GB')}
                      </TableCell>
                    </TableRow>
                  )}
                </TableBody>
              </Table>

              <Divider sx={{ my: 2 }} />

              <Typography variant="h6" sx={{ mb: 1 }}>Features:</Typography>
              <Box component="ul" sx={{ pl: 2, mb: 2 }}>
                <li>
                  {['buyer', 'tenant'].includes(userType)
                    ? `Owner details access limit:`
                    : `Property listings limit:`}
                  {subscription.no_of_properties_unlimited 
                    ? ' Unlimited' 
                    : ` ${subscription.no_of_properties || '0'}`}
                </li>

                {['individual owner/builder', 'landlord', 'agent'].includes(userType) && (
                  <>
                    <li>
                      Buyer inquiries access limit:
                      {subscription.matching_enquiry_unlimited 
                        ? ' Unlimited' 
                        : ` ${subscription.matching_enquiry || '0'}`}
                    </li>
                    <li>
                      Wishlist access limit:
                      {subscription.no_of_liked_data_unlimited 
                        ? ' Unlimited' 
                        : ` ${subscription.no_of_liked_data || '0'}`}
                    </li>
                  </>
                )}

                {['buyer', 'tenant'].includes(userType) ? (
                  <>
                    <li>Wishlist any properties</li>
                    <li>Chat with property owners</li>
                  </>
                ) : (
                  <>
                    <li>Property boosting feature</li>
                    <li>Daily wishlist tracking</li>
                  </>
                )}
              </Box>

              {/* Add-on Plans Section - Only show if there are matching add-ons */}
              {matchingAddOns.length > 0 && (
                <>
                  <Divider sx={{ my: 2 }} />
                  <Typography variant="h6" sx={{ mb: 1 }}>Add-on Plans:</Typography>
                  {matchingAddOns.map((addOn, idx) => (
                    <Box key={idx} sx={{ mb: 2, p: 2, border: '1px solid #e0e0e0', borderRadius: '8px' }}>
                      <Typography variant="subtitle1" sx={{ fontWeight: 'bold' }}>
                        {addOn.user_type} Add-on
                      </Typography>
                      <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                        Purchased on: {new Date(addOn.created_at).toLocaleDateString('en-GB')}
                      </Typography>
                      <Typography variant="body2">
                        Price: ₹{addOn.charges}
                      </Typography>
                      {renderAddOnFeatures(addOn)}
                    </Box>
                  ))}
                </>
              )}
            </Card>
          </React.Fragment>
        );
      })}

      <Button 
        variant="outlined" 
        fullWidth
        onClick={() => navigate('/work-detail')}
        sx={{ mt: 2 }}
      >
        Back to Profile
      </Button>
    </Container>
  );
};

export default ActiveSubscription;