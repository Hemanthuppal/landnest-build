import React, { useEffect, useRef } from 'react';
import { useNavigate, useLocation } from 'react-router-dom';
import HomeIcon from '@mui/icons-material/Home';
import ConstructionIcon from '@mui/icons-material/Construction';
import AddCircleIcon from '@mui/icons-material/AddCircle';
import CleaningServicesIcon from '@mui/icons-material/CleaningServices';
import AccountCircleIcon from '@mui/icons-material/AccountCircle';
import './FormsBottomNavbar.css';

const navItems = [
  { key: 'home', icon: <HomeIcon />, route: '/dashboard', label: 'Home' },
  { key: 'construction', icon: <ConstructionIcon />, route: '/constructions', label: 'Construction & Interior', 
    paths: ['/constructions', '/explore-construction-resources', '/two-d-plane-interior', '/three-d-plane-interior', '/elevations', '/packages', '/interiors', '/how-it-works', '/get-started', '/construction-get-started', '/interiorstwod', '/interiorsthreed'] },
  { key: 'spacer', isSpacer: true },
  { key: 'services', icon: <CleaningServicesIcon />, route: '/home-service', label: 'Home Services',paths: ['/work-details',] },
  { key: 'profile', icon: <AccountCircleIcon />, route: '/work-detail', label: 'More', 
    paths: ['/user-buy', '/user-profile', '/edit-profile', '/user-edit-buy', '/user-lease', '/user-edit-lease', '/user-rent', '/user-edit-rent'] },
];

const centerItem = { 
  key: 'post', 
  icon: <AddCircleIcon />, 
  route: '/post', 
  label: '',
  paths: ['/lease-form', '/sellyourproperty-form', '/rent-form', '/postyourbestdeal-form', '/vendor-form'], 
  isCenter: true 
};

const CustomBottomNavbar = () => {
  const navigate = useNavigate();
  const location = useLocation();
  const navRef = useRef(null);
  
  const isActive = (item, currentPath) => {
    // Check if current path matches any exact path in the item's paths array
    if (item.paths?.some(path => currentPath === path)) return true;
    
    // Check if current path starts with any path in the item's paths array
    if (item.paths?.some(path => currentPath.startsWith(path + '/'))) return true;
    
    // Check if current path starts with the item's base route
    if (currentPath.startsWith(item.route + '/')) return true;
    
    // Check exact match with base route
    return currentPath === item.route;
  };

  const currentKey = (() => {
    const allItems = [...navItems, centerItem];
    const found = allItems.find(item => isActive(item, location.pathname));
    return found ? found.key : '';
  })();

  const shouldShowIndicator = !isActive(centerItem, location.pathname);

  useEffect(() => {
    const indicator = document.querySelector('.cbn-indicator');
    if (!indicator) return;

    if (!shouldShowIndicator) {
      indicator.style.display = 'none';
      return;
    }

    const current = document.querySelector(`.cbn-nav-item[data-key="${currentKey}"]`);
    if (current) {
      indicator.style.display = 'block';
      const { offsetLeft, offsetWidth } = current;
      indicator.style.left = `${offsetLeft + offsetWidth / 2 - 16}px`;
    }
  }, [currentKey, location.pathname, shouldShowIndicator]);

  const handleNav = (item) => {
    if (!item.isSpacer) navigate(item.route);
  };

  return (
    <div className="cbn-wrapper">
      <div className="cbn-bar" ref={navRef}>
        {navItems.map((item) =>
          item.isSpacer ? (
            <div key="spacer" className="cbn-spacer" />
          ) : (
            <div
              key={item.key}
              data-key={item.key}
              className={`cbn-nav-item ${currentKey === item.key ? 'cbn-active' : ''}`}
              onClick={() => handleNav(item)}
            >
              {item.icon}
              <div className="cbn-label">{item.label}</div>
            </div>
          )
        )}

        <div
          className={`cbn-nav-item cbn-center ${currentKey === centerItem.key ? 'cbn-active' : ''}`}
          data-key={centerItem.key}
          onClick={() => handleNav(centerItem)}
        >
          {centerItem.icon}
          <div className="cbn-label">{centerItem.label}</div>
        </div>

        {shouldShowIndicator && <div className="cbn-indicator" />}
      </div>
    </div>
  );
};

export default CustomBottomNavbar;